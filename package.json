{
  "name": "link-shortener",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate up -m ./migrations",
    "test": "vitest",
    "lint": "eslint 'src/**' --ext .ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^8.1.0",
    "@fastify/static": "^6.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^4.27.0",
    "ioredis": "^5.3.2",
    "pg": "^8.10.0",
    "node-pg-migrate": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "supertest": "^6.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.3.3",
    "vitest": "^1.0.0"
  }
}
